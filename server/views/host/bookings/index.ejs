<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/host/css/host.css">
  <style>
    /* Booking specific styling */
    .tabs-bar {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 20px;
    }

    .tab-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 16px;
      border-radius: var(--radius-full);
      font-size: 13.5px;
      font-weight: 600;
      text-decoration: none;
      color: var(--text-body);
      background: white;
      border: 1px solid var(--border-color);
      transition: all 0.15s;
    }

    .tab-pill:hover {
      background: var(--bg-muted);
    }

    .tab-pill.active {
      background: #064E3B;
      color: white;
      border-color: #064E3B;
    }

    .tab-count-badge {
      padding: 1px 7px;
      border-radius: var(--radius-full);
      font-size: 11px;
      font-weight: 700;
      background: rgba(0, 0, 0, 0.08);
    }

    .tab-pill.active .tab-count-badge {
      background: rgba(255, 255, 255, 0.2);
    }

    /* Booking Card */
    .booking-card {
      background: white;
      border: 1px solid var(--border-color);
      border-radius: var(--radius-lg);
      padding: 24px;
      margin-bottom: 18px;
      box-shadow: var(--shadow-sm);
    }

    .booking-card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 16px;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--border-subtle);
    }

    .booking-title-text {
      font-size: 15px;
      font-weight: 700;
      color: var(--text-main);
    }

    .urgency-badge {
      font-size: 12px;
      font-weight: 600;
      padding: 4px 10px;
      border-radius: var(--radius-full);
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .urgency-badge.urgent {
      background: #FEE2E2;
      color: #B91C1C;
    }

    .urgency-badge.normal {
      background: #EFF6FF;
      color: #1D4ED8;
    }

    .booking-main-grid {
      display: grid;
      grid-template-columns: 1.4fr 1fr;
      gap: 20px;
      margin-bottom: 16px;
    }

    .customer-info-box {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 16px;
    }

    .cust-avatar {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: #D1D5DB;
      color: #374151;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 14px;
    }

    .schedule-box {
      background: #F8FAFC;
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 12px 16px;
      margin-bottom: 12px;
      font-size: 13px;
    }

    .special-req-box {
      background: #FAF5FF;
      border: 1px solid #E9D5FF;
      border-radius: var(--radius-md);
      padding: 12px 14px;
      font-size: 12.5px;
      color: #6B21A8;
      font-style: italic;
    }

    .booking-total-box {
      text-align: right;
    }

    .booking-total-val {
      font-size: 22px;
      font-weight: 800;
      color: var(--primary);
    }

    .booking-card-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-top: 14px;
      border-top: 1px solid var(--border-subtle);
    }
  </style>
</head>
<body>

<div class="host-layout">
  <!-- SIDEBAR -->
  <%- include('../partials/sidebar', { activeNav: 'bookings' }) %>

  <!-- MAIN -->
  <main class="host-main-container">
    <!-- HEADER -->
    <%- include('../partials/header', { user, breadcrumbSub: 'Duyệt đơn đặt phòng' }) %>

    <div class="host-page-body">
      <!-- TITLE -->
      <div class="host-page-header">
        <div>
          <h1 class="host-page-title" data-i18n="bk_title">Duyệt đơn đặt phòng</h1>
          <p class="host-page-subtext" data-i18n="bk_sub">Tiếp nhận và xét duyệt đơn từ khách du lịch trên ứng dụng Smart Travel</p>
        </div>
      </div>

      <!-- TABS BAR -->
      <div class="tabs-bar">
        <a href="/host/bookings?tab=pending" class="tab-pill <%= currentTab === 'pending' ? 'active' : '' %>">
          <span data-i18n="bk_tab_pending">Chờ duyệt</span>
          <span class="tab-count-badge"><%= counts.pending %></span>
        </a>
        <a href="/host/bookings?tab=confirmed" class="tab-pill <%= currentTab === 'confirmed' ? 'active' : '' %>">
          <span data-i18n="bk_tab_confirmed">Đã xác nhận</span>
          <span class="tab-count-badge"><%= counts.confirmed %></span>
        </a>
        <a href="/host/bookings?tab=history" class="tab-pill <%= currentTab === 'history' ? 'active' : '' %>">
          <span data-i18n="bk_tab_history">Lịch sử & Từ chối</span>
          <span class="tab-count-badge"><%= counts.history %></span>
        </a>
      </div>

      <!-- FILTER BAR -->
      <div class="host-filter-bar">
        <div class="host-search-box">
          <svg class="host-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input type="text" class="host-search-input" placeholder="Tìm theo mã đơn (#BK...), tên khách hoặc SĐT..." data-i18n-ph="bk_search_ph" id="searchBookingInput">
        </div>

        <select class="host-filter-select" id="selectBookingRoom">
          <option value="" data-i18n="bk_filter_all_rooms">Tất cả phòng nghỉ</option>
          <% rooms.forEach(r => { %>
            <option value="<%= r._id %>" <%= (selectedRoomId === r._id.toString()) ? 'selected' : '' %>><%= r.title %></option>
          <% }); %>
        </select>
      </div>

      <!-- BOOKINGS LIST -->
      <% if (bookings && bookings.length > 0) { %>
        <% bookings.forEach((b, idx) => { 
          const custName = b.fullName || (b.guestInfo && b.guestInfo.fullName) || (b.userId && b.userId.firstName ? (b.userId.firstName + ' ' + (b.userId.lastName || '')) : '') || 'Khách hàng';
          const custPhone = b.phoneNumber || (b.guestInfo && b.guestInfo.phoneNumber) || (b.userId && b.userId.phoneNumber) || 'Chưa có SĐT';
          const custEmail = b.email || (b.guestInfo && b.guestInfo.email) || (b.userId && b.userId.email) || '';
          const custAvatarText = custName.split(' ').filter(Boolean).map(n=>n[0]).join('').slice(0,2).toUpperCase() || 'KH';
          const specialNoteText = b.specialRequests || b.specialNote || b.notes || '';
        %>
          <div class="booking-card" id="booking-<%= b._id %>">
            <div class="booking-card-header">
              <div class="booking-title-text">
                #<%= b.bookingCode %> • <%= b.roomId ? b.roomId.title : 'Phòng' %>
              </div>
              <% if (b.status === 'PENDING') { %>
                <div class="urgency-badge <%= idx === 1 ? 'urgent' : 'normal' %>">
                  <span><%= idx === 1 ? '🔥 Khẩn cấp: Còn 5h để duyệt' : '⏱️ Còn 18h để duyệt' %></span>
                </div>
              <% } else if (b.status === 'CONFIRMED') { %>
                <span class="status-pill published">✓ Đã xác nhận</span>
              <% } else { %>
                <span class="status-pill archived">✕ <%= b.status %></span>
              <% } %>
            </div>

            <div class="booking-main-grid">
              <div>
                <div class="customer-info-box">
                  <div class="cust-avatar">
                    <%= custAvatarText %>
                  </div>
                  <div>
                    <div style="font-weight: 700; font-size: 14px; color: var(--text-main);"><%= custName %></div>
                    <div style="font-size: 12px; color: var(--text-muted);"><%= custPhone %> <%= custEmail ? '• ' + custEmail : '' %></div>
                  </div>
                </div>

                <div class="schedule-box">
                  <div style="display: flex; justify-content: space-between; margin-bottom: 6px;">
                    <div>
                      <strong>Nhận:</strong> <%= new Date(b.checkIn).toLocaleDateString('vi-VN') %> (14:00)
                    </div>
                    <div>→</div>
                    <div>
                      <strong>Trả:</strong> <%= new Date(b.checkOut).toLocaleDateString('vi-VN') %> (12:00)
                    </div>
                    <div><strong>Thời lượng:</strong> <%= b.nights || 2 %> đêm</div>
                  </div>
                  <div style="color: var(--text-muted); font-size: 12px;">
                    👥 <%= b.guests || 2 %> khách • 🛏️ <%= b.roomId?.bedrooms || 1 %> phòng ngủ
                  </div>
                </div>

                <% if (specialNoteText) { %>
                  <div class="special-req-box">
                    <strong>YÊU CẦU ĐẶC BIỆT TỪ KHÁCH HÀNG:</strong>
                    "<%= specialNoteText %>"
                  </div>
                <% } %>
              </div>

              <div class="booking-total-box">
                <div style="font-size: 11.5px; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">
                  TỔNG TIỀN THANH TOÁN
                </div>
                <div class="booking-total-val">
                  <%= Number(b.totalPrice).toLocaleString('vi-VN') %> VNĐ
                </div>
                <div style="font-size: 12px; color: #10B981; font-weight: 600; margin-top: 4px;">
                  ✓ Đã thanh toán qua <%= b.paymentMethod || 'Smart Travel Pay' %>
                </div>
              </div>
            </div>

            <div class="booking-card-footer">
              <div style="font-size: 12px; color: var(--text-muted);">
                Chính sách hủy: Hoàn tiền 100% trước 48h
              </div>

              <% if (b.status === 'PENDING') { %>
                <div style="display: flex; gap: 10px;">
                  <button type="button" class="btn btn-outline" style="color: var(--danger); border-color: #FECACA;" 
                    data-id="<%= b._id %>" 
                    data-code="<%= b.bookingCode %>" 
                    data-cust="<%= custName %>" 
                    data-total="<%= b.totalPrice %>" 
                    onclick="handleOpenRejectModal(this.dataset.id, this.dataset.code, this.dataset.cust, this.dataset.total)">
                    ✕ Từ chối
                  </button>
                  <button type="button" class="btn btn-primary" 
                    data-id="<%= b._id %>" 
                    data-code="<%= b.bookingCode %>" 
                    data-room="<%= b.roomId ? b.roomId.title : 'Phòng' %>" 
                    data-cust="<%= custName %>" 
                    data-nights="<%= b.nights || 2 %>" 
                    data-total="<%= b.totalPrice %>" 
                    onclick="handleOpenApproveModal(this.dataset.id, this.dataset.code, this.dataset.room, this.dataset.cust, this.dataset.nights, this.dataset.total)">
                    ✓ Phê duyệt đơn đặt
                  </button>
                </div>
              <% } %>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <div class="host-empty-state" style="background: white; border: 1px solid var(--border-color); border-radius: var(--radius-lg);">
          <div class="empty-icon">📂</div>
          <div class="empty-title">Không có đơn đặt phòng nào</div>
          <div class="empty-subtext">Hiện không có yêu cầu nào trong tab này.</div>
        </div>
      <% } %>
    </div>
  </main>
</div>

<!-- MODAL APPROVE BOOKING -->
<div class="modal-backdrop" id="modalApproveBooking">
  <div class="modal-dialog">
    <div class="modal-header">
      <h3 class="modal-title" style="color: var(--primary);">
        <span>✓</span> Phê duyệt an toàn
      </h3>
      <button type="button" class="modal-close-btn" onclick="closeModal('modalApproveBooking')">✕</button>
    </div>
    <div class="modal-body">
      <h2 style="font-size: 18px; font-weight: 800; margin-bottom: 6px; text-align: center;">
        Xác nhận duyệt đơn <span id="approveBookingCode">#BK-9821</span>
      </h2>
      <p style="text-align: center; font-size: 13px; color: var(--text-muted); margin-bottom: 20px;">
        Lịch phòng sẽ tự động khóa cho khoảng thời gian của đơn đặt này.
      </p>

      <div style="background: #F8FAFC; border: 1px solid var(--border-color); border-radius: 8px; padding: 14px; display: flex; justify-content: space-between; align-items: center;">
        <div>
          <div id="approveCustName" style="font-weight: 700; font-size: 14px;">Khách hàng</div>
          <div id="approveDuration" style="font-size: 12px; color: var(--text-muted);">3 đêm</div>
        </div>
        <div style="text-align: right;">
          <div style="font-size: 11px; color: var(--text-muted);">Doanh thu đơn</div>
          <div id="approveTotal" style="font-size: 16px; font-weight: 800; color: var(--primary);">7.500.000đ</div>
        </div>
      </div>
      <div style="text-align: center; margin-top: 14px; font-size: 12px; color: #10B981;">
        ✓ Tự động gửi email & thông báo tức thời cho du khách
      </div>
    </div>
    <div class="modal-footer">
      <button type="button" class="btn btn-outline" onclick="closeModal('modalApproveBooking')">Hủy</button>
      <button type="button" class="btn btn-primary" onclick="confirmApproveBooking()">✓ Xác nhận duyệt</button>
    </div>
  </div>
</div>

<!-- MODAL REJECT BOOKING -->
<div class="modal-backdrop" id="modalRejectBooking">
  <div class="modal-dialog">
    <div class="modal-header">
      <h3 class="modal-title" style="color: var(--danger);">
        <span>✕</span> Từ chối yêu cầu đặt phòng
      </h3>
      <button type="button" class="modal-close-btn" onclick="closeModal('modalRejectBooking')">✕</button>
    </div>
    <div class="modal-body">
      <div class="modal-alert-box" style="background: #FFFBEB; border-color: #FDE68A; color: #92400E;">
        <span>ℹ️</span>
        <div>Số tiền sẽ được hệ thống hoàn lại 100% về tài khoản khách du lịch trong vòng 30 giây.</div>
      </div>

      <div class="form-group">
        <label class="form-label">LÝ DO TỪ CHỐI <span class="req">*</span></label>
        <select class="form-control" id="rejectReasonSelect">
          <option value="Phòng bận đột xuất / Trùng lịch bên ngoài">Phòng bận đột xuất / Trùng lịch bên ngoài</option>
          <option value="Cơ sở đang bảo trì sửa chữa">Cơ sở đang bảo trì sửa chữa</option>
          <option value="Không đáp ứng yêu cầu đặc biệt của khách">Không đáp ứng yêu cầu đặc biệt của khách</option>
          <option value="Lý do khác">Lý do khác</option>
        </select>
      </div>

      <div class="form-group">
        <label class="form-label">LỜI NHẮN GỬI ĐẾN KHÁCH HÀNG (Tối đa 300 ký tự)</label>
        <textarea class="form-textarea" id="rejectNoteText" placeholder="Rất xin lỗi bạn vì thời gian này cơ sở lưu trú đang chuẩn bị sửa chữa một số hạng mục nên không thể tiếp đón trọn vẹn..."></textarea>
      </div>
    </div>
    <div class="modal-footer">
      <button type="button" class="btn btn-outline" onclick="closeModal('modalRejectBooking')">Đóng</button>
      <button type="button" class="btn btn-danger" onclick="confirmRejectBooking()">✕ Xác nhận từ chối</button>
    </div>
  </div>
</div>

<!-- TOAST CONTAINER -->
<div class="toast-container"></div>

<script src="/host/js/host.js"></script>
<script>
  let activeBookingId = null;

  function handleOpenApproveModal(id, code, roomTitle, custName, nights, total) {
    activeBookingId = id;
    document.getElementById('approveBookingCode').innerText = `#${code}`;
    document.getElementById('approveCustName').innerText = custName;
    document.getElementById('approveDuration').innerText = `${nights || 2} đêm`;
    document.getElementById('approveTotal').innerText = `${Number(total).toLocaleString('vi-VN')}đ`;
    openModal('modalApproveBooking');
  }

  function handleOpenRejectModal(id, code, custName, total) {
    activeBookingId = id;
    openModal('modalRejectBooking');
  }

  async function confirmApproveBooking() {
    if (!activeBookingId) return;
    try {
      const res = await fetch(`/host/bookings/${activeBookingId}/status`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status: 'CONFIRMED' })
      });
      const data = await res.json();
      closeModal('modalApproveBooking');
      if (data.success) {
        showToast('success', 'BOOKING-OK', data.message);
        setTimeout(() => window.location.reload(), 1000);
      }
    } catch (e) {
      showToast('error', 'ERR', 'Lỗi khi duyệt');
    }
  }

  async function confirmRejectBooking() {
    if (!activeBookingId) return;
    const reason = document.getElementById('rejectReasonSelect').value;
    const note = document.getElementById('rejectNoteText').value;

    try {
      const res = await fetch(`/host/bookings/${activeBookingId}/status`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          status: 'REJECTED',
          rejectReason: `${reason}: ${note}`
        })
      });
      const data = await res.json();
      closeModal('modalRejectBooking');
      if (data.success) {
        showToast('info', 'BOOKING-REJECT', data.message);
        setTimeout(() => window.location.reload(), 1000);
      }
    } catch (e) {
      showToast('error', 'ERR', 'Lỗi khi từ chối');
    }
  }
</script>
</body>
</html>
