<!-- ALL HOST PORTAL MODALS -->

<!-- 1. [CONFIRM-STA-ARCHIVE] Tạm dừng hiển thị phòng -->
<div class="modal-backdrop" id="modalConfirmArchive">
  <div class="modal-dialog">
    <div class="modal-header">
      <h3 class="modal-title">
        <span>⏸️</span> Tạm dừng hiển thị phòng
      </h3>
      <button type="button" class="modal-close-btn" onclick="closeModal('modalConfirmArchive')">✕</button>
    </div>
    <div class="modal-body">
      <div class="modal-alert-box">
        <span>ℹ️</span>
        <div>Bạn có chắc muốn tạm dừng hiển thị phòng này? Phòng sẽ không còn hiển thị cho du khách trên ứng dụng.</div>
      </div>
      <p style="color: var(--text-muted); font-size: 13px;">
        Các đơn đặt phòng đã xác nhận trước đó vẫn giữ nguyên hiệu lực. Bạn có thể mở bán lại bất kỳ lúc nào.
      </p>
    </div>
    <div class="modal-footer">
      <button type="button" class="btn btn-outline" onclick="closeModal('modalConfirmArchive')">Hủy bỏ</button>
      <button type="button" class="btn btn-primary" onclick="confirmStatusChange()">Đồng ý tạm dừng</button>
    </div>
  </div>
</div>

<!-- 2. [CONFIRM-STA-PUBLISH] Mở bán lại phòng -->
<div class="modal-backdrop" id="modalConfirmPublish">
  <div class="modal-dialog">
    <div class="modal-header">
      <h3 class="modal-title">
        <span>🚀</span> Mở bán lại phòng
      </h3>
      <button type="button" class="modal-close-btn" onclick="closeModal('modalConfirmPublish')">✕</button>
    </div>
    <div class="modal-body">
      <p>Bạn có muốn mở bán lại phòng này? Phòng sẽ được hiển thị công khai trên ứng dụng cho du khách tìm kiếm và đặt chỗ.</p>
    </div>
    <div class="modal-footer">
      <button type="button" class="btn btn-outline" onclick="closeModal('modalConfirmPublish')">Đóng</button>
      <button type="button" class="btn btn-primary" onclick="confirmStatusChange()">Xác nhận mở bán</button>
    </div>
  </div>
</div>

<!-- 3. [CONFIRM-DEL-001] Xác nhận xóa phòng (Gõ "XÓA") -->
<div class="modal-backdrop" id="modalConfirmDelete">
  <div class="modal-dialog">
    <div class="modal-header">
      <h3 class="modal-title" style="color: var(--danger);">
        <span>⚠️</span> Xóa phòng nghỉ
      </h3>
      <button type="button" class="modal-close-btn" onclick="closeModal('modalConfirmDelete')">✕</button>
    </div>
    <div class="modal-body">
      <div class="modal-alert-box danger">
        <span>🚨</span>
        <div>Thao tác này sẽ xóa vĩnh viễn dữ liệu khỏi hệ thống và không thể phục hồi.</div>
      </div>
      <div id="deleteTypeVerificationContainer">
        <label class="form-label" style="font-size: 13px; margin-top: 10px;">
          Vui lòng gõ chữ <strong>"XÓA"</strong> vào ô bên dưới để xác nhận:
        </label>
        <input type="text" class="confirm-type-input" id="deleteConfirmInput" placeholder="XÓA" autocomplete="off">
      </div>
    </div>
    <div class="modal-footer">
      <button type="button" class="btn btn-outline" onclick="closeModal('modalConfirmDelete')">Hủy bỏ</button>
      <button type="button" class="btn btn-danger" id="btnSubmitDelete" onclick="confirmDeleteRoom()" disabled>Xác nhận xóa vĩnh viễn</button>
    </div>
  </div>
</div>

<!-- 4. [ROOM-DEL-001] Chặn xóa do có booking tới -->
<div class="modal-backdrop" id="modalRoomDel001">
  <div class="modal-dialog">
    <div class="modal-header">
      <h3 class="modal-title" style="color: #D97706;">
        <span>🛑</span> Không thể xóa phòng
      </h3>
      <button type="button" class="modal-close-btn" onclick="closeModal('modalRoomDel001')">✕</button>
    </div>
    <div class="modal-body">
      <div class="modal-alert-box danger">
        <span>⚠️</span>
        <div id="roomDel001Msg">
          Không thể xóa phòng! Phòng này đang có đơn đặt phòng trong thời gian tới. Phòng được tự động chuyển sang trạng thái Tạm dừng (Archived).
        </div>
      </div>
      <p style="font-size: 13px; color: var(--text-muted);">
        Để bảo toàn thông tin cho khách đặt phòng, hệ thống tự động đưa phòng về trạng thái <strong>Tạm dừng (Archived)</strong> thay vì xóa vĩnh viễn.
      </p>
    </div>
    <div class="modal-footer">
      <button type="button" class="btn btn-primary" onclick="closeModal('modalRoomDel001'); window.location.reload();">Đã hiểu</button>
    </div>
  </div>
</div>

<!-- 5. [ROOM-IMG-001] Thiếu ảnh khi đăng bán -->
<div class="modal-backdrop" id="modalRoomImg001">
  <div class="modal-dialog">
    <div class="modal-header">
      <h3 class="modal-title" style="color: #D97706;">
        <span>🖼️</span> Album ảnh chưa đạt yêu cầu
      </h3>
      <button type="button" class="modal-close-btn" onclick="closeModal('modalRoomImg001')">✕</button>
    </div>
    <div class="modal-body">
      <div class="modal-alert-box">
        <span>⚠️</span>
        <div>Album ảnh chưa đạt yêu cầu. Bạn cần tải lên tối thiểu 3 hình ảnh rõ nét trước khi kích hoạt Đăng bán.</div>
      </div>
      <p style="font-size: 13px; color: var(--text-muted);">
        Hình ảnh thực tế giúp tăng 3x tỷ lệ khách hàng đặt phòng. Nếu chưa đủ ảnh, bạn có thể bấm <strong>"Lưu bản nháp"</strong> để bổ sung sau.
      </p>
    </div>
    <div class="modal-footer">
      <button type="button" class="btn btn-primary" onclick="closeModal('modalRoomImg001')">Tiếp tục tải ảnh</button>
    </div>
  </div>
</div>

<!-- 6. [CONFIRM-CANCEL-001] Cảnh báo hủy khi có dữ liệu chưa lưu -->
<div class="modal-backdrop" id="modalConfirmCancel">
  <div class="modal-dialog">
    <div class="modal-header">
      <h3 class="modal-title">
        <span>⚠️</span> Hủy các thay đổi?
      </h3>
      <button type="button" class="modal-close-btn" onclick="closeModal('modalConfirmCancel')">✕</button>
    </div>
    <div class="modal-body">
      <p>Bạn có chắc chắn muốn hủy? Mọi thay đổi chưa lưu trên form này sẽ bị mất.</p>
    </div>
    <div class="modal-footer">
      <button type="button" class="btn btn-outline" onclick="closeModal('modalConfirmCancel')">Ở lại chỉnh sửa</button>
      <a href="/host/rooms" class="btn btn-danger">Đồng ý rời khỏi</a>
    </div>
  </div>
</div>

<!-- 7. [ROOM-RESTORE-001] Khôi phục bản nháp từ phiên làm việc trước -->
<div class="modal-backdrop" id="modalRoomRestore">
  <div class="modal-dialog">
    <div class="modal-header">
      <h3 class="modal-title">
        <span>🔄</span> Khôi phục bản nháp
      </h3>
      <button type="button" class="modal-close-btn" onclick="discardRestoreDraft()">✕</button>
    </div>
    <div class="modal-body">
      <p>Tìm thấy nội dung chưa lưu từ phiên làm việc trước. Bạn có muốn khôi phục không?</p>
    </div>
    <div class="modal-footer">
      <button type="button" class="btn btn-outline" onclick="discardRestoreDraft()">Bỏ qua</button>
      <button type="button" class="btn btn-primary" onclick="confirmRestoreDraft()">Khôi phục dữ liệu</button>
    </div>
  </div>
</div>

<!-- 8. [AUTH-401-EXPIRED] Modal xác thực nhanh khi hết hạn Token -->
<div class="modal-backdrop" id="modalQuickAuth">
  <div class="modal-dialog">
    <div class="modal-header">
      <h3 class="modal-title">
        <span>🔒</span> Xác thực lại phiên làm việc
      </h3>
    </div>
    <div class="modal-body">
      <div class="modal-alert-box">
        <span>⏱️</span>
        <div>Phiên làm việc đã hết hạn. Vui lòng xác thực lại mật khẩu để tiếp tục lưu dữ liệu mà không làm mất thông tin vừa nhập.</div>
      </div>
      <div class="form-group">
        <label class="form-label">Tài khoản Host</label>
        <input type="email" class="form-control" id="quickAuthEmail" value="<%= typeof user !== 'undefined' && user ? user.email : 'robinnguyen@gmail.com' %>" readonly style="background: #F1F5F9;">
      </div>
      <div class="form-group">
        <label class="form-label">Mật khẩu</label>
        <input type="password" class="form-control" id="quickAuthPassword" placeholder="Nhập mật khẩu của bạn..." value="123456">
      </div>
    </div>
    <div class="modal-footer">
      <button type="button" class="btn btn-primary" onclick="confirmQuickAuth()">Xác thực & Tiếp tục lưu</button>
    </div>
  </div>
</div>

<!-- 9. Modal Thêm tiện ích đặc thù mới -->
<div class="modal-backdrop" id="modalAddAmenity">
  <div class="modal-dialog">
    <div class="modal-header">
      <h3 class="modal-title">
        <span>✨</span> Thêm tiện ích mới
      </h3>
      <button type="button" class="modal-close-btn" onclick="closeModal('modalAddAmenity')">✕</button>
    </div>
    <div class="modal-body">
      <div class="form-group">
        <label class="form-label">Tên tiện ích đặc thù</label>
        <input type="text" class="form-control" id="customAmenityName" placeholder="Vd: Kính thiên văn, Ghế massage, Bàn bi-a...">
      </div>
    </div>
    <div class="modal-footer">
      <button type="button" class="btn btn-outline" onclick="closeModal('modalAddAmenity')">Hủy</button>
      <button type="button" class="btn btn-primary" onclick="confirmAddCustomAmenity()">+ Thêm vào danh mục</button>
    </div>
  </div>
</div>

<!-- 10. Modal Điều chỉnh ghim tọa độ GPS -->
<div class="modal-backdrop" id="modalMapAdjust">
  <div class="modal-dialog" style="max-width: 820px;">
    <div class="modal-header">
      <h3 class="modal-title">
        <span>📍</span> <span data-i18n="modal_map_title">Điều chỉnh vị trí ghim bản đồ</span>
      </h3>
      <button type="button" class="modal-close-btn" onclick="closeModal('modalMapAdjust')">✕</button>
    </div>
    <div class="modal-body">
      <p style="font-size: 13px; color: var(--text-muted); margin-bottom: 12px;" data-i18n="modal_map_sub">
        Click vào bản đồ hoặc kéo ghim để cập nhật tọa độ chính xác cho cơ sở lưu trú của bạn:
      </p>
      
      <!-- Fullsize Leaflet Map Container -->
      <div id="hostModalMap" style="height: 400px; width: 100%; border-radius: 10px; border: 1px solid var(--border-color); z-index: 1;"></div>
      
      <div style="margin-top: 14px; display: flex; justify-content: space-between; align-items: center; background: #F8FAFC; padding: 10px 14px; border-radius: 8px; border: 1px solid var(--border-color);">
        <div style="font-weight: 700; font-size: 13.5px; color: var(--text-main);">
          <span data-i18n="gps_coord_label">TỌA ĐỘ GPS:</span>
          <span id="modalDisplayCoordText" style="color: var(--primary); font-family: monospace; font-size: 14px; margin-left: 6px;">16.0678° N, 108.2208° E</span>
        </div>
        <div style="font-size: 12px; color: var(--text-muted);">
          <span>Kéo ghim hoặc click bất kỳ điểm nào để chọn</span>
        </div>
      </div>
    </div>
    <div class="modal-footer">
      <button type="button" class="btn btn-outline" onclick="closeModal('modalMapAdjust')" data-i18n="modal_map_close">Đóng</button>
      <button type="button" class="btn btn-primary" onclick="confirmSaveModalCoords()" data-i18n="modal_map_save">Lưu tọa độ</button>
    </div>
  </div>
</div>
