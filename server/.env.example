# Application Port
PORT=5000

# Database
MONGO_URI=mongodb://localhost:27017/smart_travel

# JWT Auth
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=30d

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here

