# ==============================
# Server Environment Variables
# ==============================

# Application Port
PORT=5000

# Database
MONGO_URI=mongodb://localhost:27017/smart_travel

# JWT Auth
ACCES_TOKEN_SECRET=your_jwt_access_token_secret_here

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here

# Third-party & File Uploads (Nếu có)
# CLOUDINARY_URL=...

# Email Configuration (Dùng cho Gửi mã OTP)
EMAIL_USER=your_email@gmail.com
OAUTH_CLIENT_ID=your_oauth_client_id
OAUTH_CLIENT_SECRET=your_oauth_client_secret
OAUTH_REFRESH_TOKEN=your_oauth_refresh_token
EMAIL_PASS=your_app_password_optional
