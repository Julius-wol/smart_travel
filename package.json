{
  "name": "smart-travel-platform",
  "version": "1.0.0",
  "description": "Smart Travel Platform Monorepo - Server & Mobile App",
  "private": true,
  "workspaces": [
    "server",
    "mobile-app"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev:server": "npm run dev --workspace=server",
    "dev:mobile": "npm run start --workspace=mobile-app",
    "dev:all": "concurrently -c \"blue,magenta\" -n \"SERVER,MOBILE\" \"npm run dev:server\" \"npm run dev:mobile\"",
    "test:server": "npm run test --workspace=server",
    "test:mobile": "npm run test --workspace=mobile-app",
    "test:mobile:e2e": "npm --prefix mobile-app run test:e2e",
    "test:e2e": "npm run test:mobile:e2e",
    "test": "npm run test:server && npm run test:mobile",
    "seed": "npm run seed --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
