{
  "name": "smart-travel-platform",
  "version": "1.0.0",
  "description": "Smart Travel Platform Monorepo - Server & Mobile App",
  "private": true,
  "workspaces": [
    "server",
    "mobile-app"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev:server": "npm run dev --workspace=server",
    "dev:mobile": "npm run start --workspace=mobile-app",
    "dev:all": "concurrently -c \"blue,magenta\" -n \"SERVER,MOBILE\" \"npm run dev:server\" \"npm run dev:mobile\""
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
