{
  "name": "mobile-app",
  "version": "1.0.0",
  "main": "App.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "jest --watchAll=false",
    "test:unit": "jest __tests__ --watchAll=false",
    "test:e2e": "jest e2e --watchAll=false --runInBand --forceExit",
    "test:all": "jest --watchAll=false --forceExit"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|react-native-paper)"
    ],
    "moduleNameMapper": {
      "^react-native/asset-registry$": "<rootDir>/../node_modules/@react-native/assets-registry/registry.js",
      "^immer$": "<rootDir>/../node_modules/immer/dist/cjs/index.js",
      "^react-redux$": "<rootDir>/../node_modules/react-redux/dist/cjs/index.js"
    }
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "@reduxjs/toolkit": "^2.13.0",
    "axios": "^1.20.0",
    "expo": "^57.0.27",
    "expo-sqlite": "^57.0.4",
    "formik": "^2.4.9",
    "react": "^19.3.0",
    "react-native": "^0.86.3",
    "react-native-paper": "^5.15.3",
    "react-native-safe-area-context": "^5.10.1",
    "react-native-screens": "^4.28.0",
    "react-redux": "^9.3.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.11",
    "react-test-renderer": "^19.3.0"
  }
}
