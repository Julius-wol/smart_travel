{
  "expo": {
    "name": "Smart Travel",
    "slug": "smart-travel",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "scheme": [
      "smarttravel",
      "com.smarttravel.app"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.smarttravel.app"
    },
    "android": {
      "package": "com.smarttravel.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-web-browser",
      "expo-sqlite"
    ],
    "extra": {
      "eas": {
        "projectId": "f95755f4-b7ef-4e29-a99f-9307e1cc643e"
      }
    }
  }
}
